{
  "name": "city-hall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "snapshot:build": "tsx scripts/build-inventory-snapshot.ts",
    "snapshot:diff": "tsx scripts/diff-inventory-snapshots.ts",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "capture": "tsx scripts/capture-portal.ts",
    "replay": "tsx scripts/replay-snapshots.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
